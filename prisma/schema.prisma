
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String      @id
  title                 String?
  name                  String
  email                 String      @unique
  qualification         String?
  cellNo                String?
  dateOfBirth           DateTime    @default(now())       @map("dateOfBirth")
  gender                Gender      @default(Other)  
  medCareId             String?  
  emailVerified         Boolean     @default(false)
  role                  Roles       @default(Patient) 
  specialties           Specialty[]
  banned                Boolean?    @default(true)
  bannedReason          String?     @default("Pending for admin for access")
  banReason             String?     @default("Pending for admin for access")

  bannedUntil           DateTime?   @db.Timestamptz(3)      
  banExpires            DateTime?   @db.Timestamptz(3)      

  impersonatedBy        String?
  impersonatorId        String?
  failedAttempts        Int         @default(0)
  image                 String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
 
  sessions              Session[]
  accounts              Account[]
  patientPrescriptions  PatientPrescription[] @relation("PatientRelation")
  doctorPrescriptions   PatientPrescription[] @relation("DoctorRelation")
  patientAppointments   Appointment[]         @relation("PatientRelation")
  doctorAppointments    Appointment[]         @relation("DoctorRelation")
  doctorSlots           DoctorSlots[]         @relation("DoctorRelation")

  @@unique([medCareId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatorId    String?
  impersonatedBy String?
  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model PatientPrescription {
  id                      Int         @id  @default(autoincrement())
  note                    String? 
  prescriptionsContent    String? 
  createdPrescription     DateTime    @default(now())
  relatedImages           String?
  prescriptionImage       String?
  activeStatus            Boolean     @default(true)
  prescriptionSubmitted   Boolean     @default(false)
  medCareId               String
  patient                 User?             @relation("PatientRelation", fields: [medCareId], references: [medCareId])  
  doctorId                String?
  doctor                User?             @relation("DoctorRelation", fields: [doctorId], references: [id])
  
  @@index([id])
}

model MedicineList {
  id                              Int         @id  @default(autoincrement())
  medicineContentEnglish          String?  
  medicineContentUrdu             String?
  Dosage                          String?
  createdPrescription             DateTime    @default(now())
  activeStatus                    Boolean     @default(true)                        
  @@index([id])
}

model Appointment {
  id                      Int         @id  @default(autoincrement())
  patientId               String?
  patient                 User?             @relation("PatientRelation", fields: [patientId], references: [id])  
  doctorId                String?
  doctor                  User?             @relation("DoctorRelation", fields: [doctorId], references: [id])
  date                    DateTime
  status                  AppointmentStatus
  createdAt               DateTime    @default(now())
  updatedAt               DateTime?    @updatedAt
  
  @@index([id])
  @@index([doctorId, date])
}

model DoctorSlots {
  id                    Int           @id  @default(autoincrement())
  doctorId              String
  doctor                User?             @relation("DoctorRelation", fields: [doctorId], references: [id])
  day                   DayOfWeek  
  startTimeMinutes      Int
  endTimeMinutes        Int  
  createdAt             DateTime    @default(now())
  isBooked              Boolean    @default(false)

@@unique([doctorId, day, startTimeMinutes])
@@index([doctorId])
}

model CronJobsLog {
  id               Int       @id @default(autoincrement())
  cronType         CronType
  cronStatus       CronStatus
  cronStatusText   String
  updatedCount     Int
  createdAt        DateTime  @default(now())

  @@index([id])

}

enum CronType {
  Upcoming_update_NoShow    
  Email_sent_NoShow        
}

enum CronStatus {
  Success
  Failed
  Warning
}

enum DayOfWeek {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum AppointmentStatus {
  Upcoming
  Completed
  Cancelled
  NoShow
}

enum Gender {
  Male
  Female
  Other
}

enum Roles {
  Patient
  Doctor
  Admin
}

enum Specialty{
    Cardiology
    Dermatology
    General_Medicine @map("General Medicine")
    Pediatrics
}
